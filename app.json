{
  "expo": {
    "name": "Capito",
    "slug": "budget-keepr",
    "version": "2.0.0",
    "runtimeVersion": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app_icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash_2.png",
      "resizeMode": "contain",
      "backgroundColor": "#000"
    },
    "backgroundColor": "#000",
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.budgetkeepr",
      "appleTeamId": "JGB33Y2CF3"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.budgetkeepr",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "expo-font",
      [
        "@sentry/react-native/expo",
        {
          "organization": "cf913",
          "project": "react-native",
          "url": "https://sentry.io"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "160e0efd-d9b3-4f6e-b454-6a41cf0e32fd"
      }
    },
    "owner": "chad_fallotin",
    "updates": {
      "url": "https://u.expo.dev/160e0efd-d9b3-4f6e-b454-6a41cf0e32fd",
      "requestHeaders": {
        "expo-channel-name": "preview"
      }
    }
  }
}
